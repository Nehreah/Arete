<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de respaldo (Auto Backup) para Android API 31+.
   Excluye explícitamente todas las claves criptográficas, pines TOFU y bases de datos locales
   para evitar fugas de identidad o corrupción del Keystore tras restauración.
-->
<full-backup-content>
    <!-- Exclusión de preferencias compartidas que contienen claves o identidades criptográficas -->
    <exclude domain="sharedpref" path="antired_crypto_keystore.xml" />
    <exclude domain="sharedpref" path="antired_crypto_keystore_enc.xml" />
    <exclude domain="sharedpref" path="antired_crypto_identity.xml" />
    <exclude domain="sharedpref" path="antired_crypto_identity_enc.xml" />
    <exclude domain="sharedpref" path="antired_pines.xml" />
    <exclude domain="sharedpref" path="antired_pines_cifrado.xml" />
    <exclude domain="sharedpref" path="antired_identity_v1_prefs.xml" />
    <exclude domain="sharedpref" path="antired_identity_v1_secure_prefs.xml" />
    <exclude domain="sharedpref" path="antired_sesion_local_prefs.xml" />

    <!-- Exclusión de archivos de claves privadas y bases de datos locales outbox/mesh/room -->
    <exclude domain="file" path="crypto" />
    <exclude domain="database" path="antired_outbox.db" />
    <exclude domain="database" path="antired_outbox.db-wal" />
    <exclude domain="database" path="antired_outbox.db-shm" />
    <exclude domain="database" path="antired_local_db" />
    <exclude domain="database" path="antired_local_db-wal" />
    <exclude domain="database" path="antired_local_db-shm" />
</full-backup-content>