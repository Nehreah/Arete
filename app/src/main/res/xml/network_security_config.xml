<?xml version="1.0" encoding="utf-8"?>
<!--
   SEC-06: Configuración de seguridad de red para Aréte Social.
   Bloquea el tráfico no cifrado (cleartext HTTP) globalmente por política fail-closed.
   Permite únicamente excepciones explícitas para loopback/desarrollo local si fuera necesario.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
