# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE FIRMA DE RELEASE (keystore.properties)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como 'keystore.properties' en la raíz de tu proyecto:
#    cp keystore.properties.example keystore.properties
# 2. Reemplaza los valores con la información de tu almacén de claves (.jks / .keystore).
# 3. 'keystore.properties' está ignorado en .gitignore para proteger tus credenciales.
#
# Generación de una clave nueva (si aún no tienes una):
# keytool -genkey -v -keystore my-release-key.jks -alias arete_release -keyalg RSA -keysize 2048 -validity 10000
# ==============================================================================

# Ruta al archivo .jks o .keystore (relativa a la carpeta 'app/' o absoluta)
storeFile=/home/nehreah/Proyectos/AntiRed/my-release-key.jks

# Contraseña del almacén de claves (Keystore password)
storePassword=tu_contraseña_keystore

# Alias de la clave dentro del almacén (Key alias)
keyAlias=arete_release

# Contraseña de la clave específica (Key password)
keyPassword=tu_contraseña_clave
